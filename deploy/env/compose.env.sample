POSTGRES_DB=stock2
POSTGRES_USER=stock2
POSTGRES_PASSWORD=replace-with-postgres-password
POSTGRES_PORT=5432

WEB_PORT=3000
API_PORT=8000

STOCK2_NETWORK_SUBNET=10.15.11.0/24

STOCK2_WEB_IMAGE=ghcr.io/leon-drq/stock2-web:release-test
STOCK2_API_IMAGE=ghcr.io/leon-drq/stock2-api:release-test

# Default model configuration used by Next.js AI routes.
#
# Supported DEFAULT_MODEL_PROVIDER values:
# - deepseek: https://api.deepseek.com/v1
#   Models: deepseek-v4-flash, deepseek-v4-pro
# - openai: https://api.openai.com/v1
#   Models: gpt-4o-mini, gpt-4.1-mini, gpt-4.1
# - kimi: https://api.moonshot.cn/v1
#   Models: moonshot-v1-8k, moonshot-v1-32k, moonshot-v1-128k
# - qwen: https://dashscope.aliyuncs.com/compatible-mode/v1
#   Models: qwen-plus, qwen-max, qwen-turbo
#
# Put the selected provider's API key here. Do not use NEXT_PUBLIC_*.
MODEL_PROVIDER_KEY=
DEFAULT_MODEL_PROVIDER=deepseek
DEFAULT_MODEL_NAME=deepseek-v4-flash

# Optional legacy provider-specific keys. MODEL_PROVIDER_KEY takes priority for the default model.
QVERIS_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
KIMI_API_KEY=
QWEN_API_KEY=

SESSION_SECRET=replace-with-long-random-secret
INTERNAL_API_TOKEN=replace-with-internal-api-token
INTERNAL_CRON_TOKEN=replace-with-internal-cron-token

BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-strong-admin-password
CORS_ORIGINS=http://localhost:3000
