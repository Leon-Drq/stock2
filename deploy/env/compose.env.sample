POSTGRES_DB=stock2
POSTGRES_USER=stock2
POSTGRES_PASSWORD=replace-with-postgres-password
POSTGRES_PORT=5432

WEB_PORT=3000
API_PORT=8000

STOCK2_NETWORK_SUBNET=10.15.11.0/24

STOCK2_WEB_IMAGE=ghcr.io/leon-drq/stock2-web:release-test
STOCK2_API_IMAGE=ghcr.io/leon-drq/stock2-api:release-test

QVERIS_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# DeepSeek model IDs: deepseek-v4-flash or deepseek-v4-pro.
DEFAULT_MODEL_PROVIDER=deepseek
DEFAULT_MODEL_NAME=deepseek-v4-flash

SESSION_SECRET=replace-with-long-random-secret
INTERNAL_API_TOKEN=replace-with-internal-api-token
INTERNAL_CRON_TOKEN=replace-with-internal-cron-token

BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-strong-admin-password
CORS_ORIGINS=http://localhost:3000
