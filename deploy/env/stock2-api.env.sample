# PostgreSQL connection used by the Python API.
DATABASE_URL=postgresql://stock2:replace-with-postgres-password@postgres:5432/stock2

# Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-long-random-session-secret

# Internal API token for server-to-server calls.
INTERNAL_API_TOKEN=replace-with-internal-api-token

# Shared token used by APScheduler when calling Next.js cron routes.
INTERNAL_CRON_TOKEN=replace-with-internal-cron-token

# Internal Docker network URL for stock2-web.
NEXT_INTERNAL_BASE_URL=http://stock2-web:3000

# Initial admin account. Only created when the user does not exist.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-strong-admin-password

SESSION_COOKIE_NAME=stock2_session
SESSION_TTL_SECONDS=604800

# For direct browser calls to the API. The default deployment uses the same-origin web proxy.
CORS_ORIGINS=http://localhost:3000
