NODE_ENV=production
PORT=3000
WEB_PORT=3000

# Next.js runtime database access.
DATABASE_URL=postgresql://stock2:replace-with-postgres-password@postgres:5432/stock2

# Server-side proxy from stock2-web to stock2-api.
PYTHON_API_URL=http://stock2-api:8000

# Must match stock2-api and stock2-scheduler.
INTERNAL_API_TOKEN=replace-with-internal-api-token
CRON_SECRET=replace-with-internal-cron-token

# Default model configuration used by Next.js AI routes.
#
# Supported DEFAULT_MODEL_PROVIDER values:
# - deepseek: deepseek-v4-flash, deepseek-v4-pro
# - openai: gpt-4o-mini, gpt-4.1-mini, gpt-4.1
# - kimi: moonshot-v1-8k, moonshot-v1-32k, moonshot-v1-128k
# - qwen: qwen-plus, qwen-max, qwen-turbo
#
# Put the selected provider's API key here. Do not use NEXT_PUBLIC_*.
MODEL_PROVIDER_KEY=
DEFAULT_MODEL_PROVIDER=deepseek
DEFAULT_MODEL_NAME=deepseek-v4-flash

# Optional legacy provider-specific keys. MODEL_PROVIDER_KEY takes priority for the default model.
QVERIS_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
KIMI_API_KEY=
QWEN_API_KEY=
