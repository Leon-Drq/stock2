NODE_ENV=production
PORT=3000
WEB_PORT=3000

# Next.js runtime database access.
DATABASE_URL=postgresql://stock2:replace-with-postgres-password@postgres:5432/stock2

# Server-side proxy from stock2-web to stock2-api.
PYTHON_API_URL=http://stock2-api:8000

# Must match stock2-api and stock2-scheduler.
INTERNAL_API_TOKEN=replace-with-internal-api-token
CRON_SECRET=replace-with-internal-cron-token

# Optional model providers.
QVERIS_API_KEY=
OPENAI_API_KEY=
